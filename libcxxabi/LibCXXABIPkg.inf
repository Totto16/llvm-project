[Defines]
  INF_VERSION = 1.25
  BASE_NAME = LibCXXABILib
  FILE_GUID = fac525d4-f55d-4a3d-85b7-5a5a3d8d348a
  MODULE_TYPE = BASE
  VERSION_STRING = 22.1.8
  LIBRARY_CLASS = LibCXXABI|UEFI_APPLICATION 

[Sources]
# C++ABI files
  src/cxa_aux_runtime.cpp
  src/cxa_default_handlers.cpp
  src/cxa_demangle.cpp
  src/cxa_exception_storage.cpp
  src/cxa_guard.cpp
  src/cxa_handlers.cpp
  src/cxa_vector.cpp
  src/cxa_virtual.cpp

# C++ STL files
  src/stdlib_exception.cpp
  src/stdlib_stdexcept.cpp
  src/stdlib_typeinfo.cpp

# Internal files
  src/abort_message.cpp
  src/fallback_malloc.cpp
  src/private_typeinfo.cpp
# libcxxabi_enable_new_delete_definitions
  src/stdlib_new_delete.cpp
## libcxxabi_enable_exceptions
#  src/cxa_exception.cpp
#  src/cxa_personality.cpp
# !libcxxabi_enable_exceptions
  src/cxa_noexception.cpp

[Packages]
  MdePkg/MdePkg.dec
  LLVM/LLVMPkg.dec
  StdLib/StdLib.dec

[LibraryClasses]
# MdePkg
  UefiLib
# LLVM
  LibCXX
# StdLib
  LibC
  LibCType
  LibLocale
  LibMath
  LibSignal
  LibStdio
  LibStdLib
  LibString
  LibTime
  LibUefi
  LibWchar
  LibGdtoa


[BuildOptions]
  *_*_*_CXX_FLAGS  = -std=c++23 -nostdinc++ -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-use-cxa-atexit

  *_*_*_CC_FLAGS = -D__UEFI__
  *_*_*_CC_FLAGS = "-DEFIAPI=__attribute__((ms_abi))"
  
  *_*_*_CC_FLAGS = -fvisibility=hidden
  *_*_*_CXX_FLAGS = -D_REENTRANT
  *_*_*_CC_FLAGS = -I$(MODULE_DIR)/include

  *_*_*_CC_FLAGS = -I$(EDK2_LIBC_ROOT)/StdLib/Include
  *_*_*_CXX_FLAGS = -I$(EDK2_LLVM_ROOT)/libcxx/include
  *_*_*_CXX_FLAGS = -I$(EDK2_LLVM_ROOT)/libcxx/src
  *_*_*_CXX_FLAGS = -I$(EDK2_LLVM_ROOT)/libunwind/include

  *_*_*_CC_FLAGS = -Wno-attributes
  *_*_*_CC_FLAGS = -D_LIBCPP_BUILDING_LIBRARY -D_LIBCXXABI_BUILDING_LIBRARY
  *_*_*_CC_FLAGS = -fshort-wchar

  *_*_*_CC_FLAGS = -I$(EDK2_LLVM_ROOT)/libc

[BuildOptions.X64]
  *_*_*_CC_FLAGS = -I$(EDK2_LIBC_ROOT)/StdLib/Include/X64
